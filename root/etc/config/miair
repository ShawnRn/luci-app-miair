config miair 'config'
	option enabled '0'
	option name '小爱音箱投放'
	option airplay_enabled '1'
	option dlna_enabled '1'
	option port '5000'
	option http_port '8300'
	option dlna_port '8301'
	option buffer_ms '500'
	option source_policy 'latest'
	option idle_timeout '10'
	option preferred_protocol 'airplay'
	option did ''
	option mi_token_store '/etc/miair/token.json'
