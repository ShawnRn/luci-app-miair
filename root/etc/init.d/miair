#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/miair-core

start_service() {
	config_load miair

	local enabled name port http_port device_did mi_user mi_pass mi_token_store
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get name config name "小爱音箱 AirPlay"
	config_get port config port "5000"
	config_get http_port config http_port "8300"
	config_get device_did config device_did ""
	config_get mi_user config mi_user ""
	config_get mi_pass config mi_pass ""
	config_get mi_token_store config mi_token_store "/etc/miair/token.json"

	mkdir -p /etc/miair

	procd_open_instance
	procd_set_param command "$PROG"
	procd_append_param command -name "$name"
	procd_append_param command -port "$port"
	procd_append_param command -http-port "$http_port"
	[ -n "$device_did" ] && procd_append_param command -device "$device_did"
	[ -n "$mi_user" ] && procd_append_param command -user "$mi_user"
	[ -n "$mi_pass" ] && procd_append_param command -pass "$mi_pass"
	[ -n "$mi_token_store" ] && procd_append_param command -store "$mi_token_store"

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall -9 miair-core 2>/dev/null
}
